<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MULExplorer.ViewModels.Tabs"
             xmlns:c="using:MULExplorer.Controls"
             xmlns:r="using:MULExplorer.Resources"
             x:Class="MULExplorer.Views.Tabs.TexturesView"
             x:DataType="vm:TexturesViewModel">
    <Grid ColumnDefinitions="*,6,320" RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="6">
            <TextBox Name="SearchBox" Width="260" PlaceholderText="{x:Static r:Strings.SearchWatermark}"
                     Text="{Binding SearchText}" />
            <CheckBox Content="{x:Static r:TexturesStrings.ShowFreeSlots}" IsChecked="{Binding ShowFreeSlots}" />
        </StackPanel>

        <!-- Thumbnails -->
        <c:TileGrid Name="Grid" Grid.Row="1" CellWidth="68" CellHeight="68"
                    Ids="{Binding VisibleIds}"
                    ImageProvider="{Binding ThumbnailProvider}"
                    SelectedId="{Binding SelectedId}" />

        <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns" />

        <!-- Preview + details -->
        <ScrollViewer Grid.Row="1" Grid.Column="2">
            <StackPanel Margin="8" Spacing="8">
                <Border Classes="preview" MinHeight="160">
                    <Image Name="PreviewImage" Source="{Binding Preview}" Stretch="None"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ItemsControl ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PropertyRow">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="label" Text="{Binding Label}" />
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="status" Text="{Binding Summary}" />
    </Grid>
</UserControl>
