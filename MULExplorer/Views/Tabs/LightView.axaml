<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MULExplorer.ViewModels.Tabs"
             xmlns:r="using:MULExplorer.Resources"
             x:Class="MULExplorer.Views.Tabs.LightView"
             x:DataType="vm:LightViewModel">
    <Grid ColumnDefinitions="160,6,*,6,280" RowDefinitions="*,Auto">
        <!-- Light ids -->
        <DockPanel Margin="6">
            <TextBlock DockPanel.Dock="Top" Classes="label" Margin="0,0,0,4" Text="{x:Static r:LightStrings.Lights}" />
            <ListBox Name="LightList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:LightRow">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- Preview -->
        <Border Grid.Column="2" Classes="preview" Margin="0,6,0,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image Name="PreviewImage" Source="{Binding Preview}" Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

        <!-- Options (UOFiddler's preview context menu) + light levels -->
        <ScrollViewer Grid.Column="4">
            <StackPanel Margin="8" Spacing="8">
                <CheckBox Name="InGameBox" Content="{x:Static r:LightStrings.InGamePreview}" IsChecked="{Binding InGame}" />
                <TextBlock Text="{x:Static r:LightStrings.LandTile}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Name="LandBox" Width="140" VerticalAlignment="Center" Minimum="0" Maximum="16383" Increment="1" FormatString="0"
                                   Value="{Binding LandTile}" IsEnabled="{Binding InGame}" />
                    <Image Source="{Binding LandPreview}" Width="44" Height="44" Stretch="None" />
                </StackPanel>
                <TextBlock Text="{x:Static r:LightStrings.LightSource}" />
                <NumericUpDown Name="SourceBox" Width="140" HorizontalAlignment="Left" Minimum="-1" Maximum="65535" Increment="1"
                               FormatString="0" Value="{Binding LightSource}" IsEnabled="{Binding InGame}" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PropertyRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="label" Text="{Binding Label}" />
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Classes="status" Text="{Binding Summary}" />
    </Grid>
</UserControl>
