<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MULExplorer.ViewModels.Tabs"
             xmlns:r="using:MULExplorer.Resources"
             x:Class="MULExplorer.Views.Tabs.SkillsView"
             x:DataType="vm:SkillsViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.table ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="*,6,320" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12" Margin="6">
            <TextBox Name="SearchBox" Width="260" PlaceholderText="{x:Static r:Strings.SearchWatermark}"
                     Text="{Binding SearchText}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="60,90,*" Margin="6,0,6,2">
            <TextBlock Classes="label" Text="{x:Static r:Strings.Id}" />
            <TextBlock Grid.Column="1" Classes="label" Text="{x:Static r:SkillsStrings.IsAction}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{x:Static r:Strings.Name}" />
        </Grid>

        <ListBox Name="SkillList" Grid.Row="2" Classes="table" ItemsSource="{Binding VisibleSkills}"
                 SelectedItem="{Binding SelectedSkill}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:SkillRow">
                    <Grid ColumnDefinitions="60,90,*">
                        <TextBlock Text="{Binding Index}" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsAction, Mode=OneWay}" IsHitTestVisible="False"
                                  Focusable="False" MinHeight="0" Padding="0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" ResizeDirection="Columns" />

        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">
            <ItemsControl Margin="8" ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PropertyRow">
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="label" Text="{Binding Label}" />
                            <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Classes="status" Text="{Binding Summary}" />
    </Grid>
</UserControl>
