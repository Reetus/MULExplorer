<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MULExplorer.ViewModels.Tabs"
             xmlns:c="using:MULExplorer.Controls"
             xmlns:r="using:MULExplorer.Resources"
             x:Class="MULExplorer.Views.Tabs.FontsView"
             x:DataType="vm:FontsViewModel">
    <Grid ColumnDefinitions="190,6,*,6,300" RowDefinitions="*,6,Auto,Auto">
        <!-- Font list (UOFiddler's ASCII / Unicode tree) -->
        <DockPanel Margin="6">
            <TextBlock DockPanel.Dock="Top" Classes="label" Text="{x:Static r:FontsStrings.FontFamily}" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,2,0,6">
                <RadioButton Name="AsciiRadio" GroupName="FontKind" Content="{x:Static r:FontsStrings.Ascii}" IsChecked="{Binding !IsUnicode}" />
                <RadioButton Name="UnicodeRadio" GroupName="FontKind" Content="{x:Static r:FontsStrings.Unicode}" IsChecked="{Binding IsUnicode}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Classes="label" Text="{x:Static r:FontsStrings.Fonts}" />
            <ListBox Name="FontList" Margin="0,2,0,0" ItemsSource="{Binding FontList}" SelectedItem="{Binding SelectedFont}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:FontEntry">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- Character grid -->
        <DockPanel Grid.Column="2" Margin="0,6,0,0">
            <TextBox DockPanel.Dock="Top" Name="SearchBox" Width="260" HorizontalAlignment="Left" Margin="0,0,0,6"
                     PlaceholderText="{x:Static r:FontsStrings.SearchWatermark}" Text="{Binding SearchText}" />
            <c:TileGrid Name="Grid" CellWidth="40" CellHeight="40"
                        Ids="{Binding VisibleChars}"
                        ImageProvider="{Binding GlyphProvider}"
                        SelectedId="{Binding SelectedChar}" />
        </DockPanel>

        <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

        <!-- Character details -->
        <ScrollViewer Grid.Column="4">
            <StackPanel Margin="8" Spacing="8">
                <Border Classes="preview" MinHeight="140">
                    <Image Name="GlyphImage" Source="{Binding GlyphPreview}" Stretch="None"
                           RenderOptions.BitmapInterpolationMode="None"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ItemsControl ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PropertyRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="label" Text="{Binding Label}" />
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" ResizeDirection="Rows" />

        <!-- Text preview -->
        <Grid Grid.Row="2" Grid.ColumnSpan="5" ColumnDefinitions="340,*" Margin="6">
            <StackPanel Spacing="6">
                <TextBlock Classes="label" Text="{x:Static r:FontsStrings.PreviewText}" />
                <TextBox Name="PreviewTextBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding PreviewText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="{x:Static r:FontsStrings.PreviewHue}" />
                    <NumericUpDown Name="HueBox" Width="130" Minimum="0" Maximum="3000" Increment="1" FormatString="0"
                                   Value="{Binding PreviewHue}" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Classes="preview" Margin="8,0,0,0" MinHeight="110">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <!-- Client fonts are tiny; show them at 2x with crisp pixels. -->
                    <LayoutTransformControl HorizontalAlignment="Left" VerticalAlignment="Top">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="2" ScaleY="2" />
                        </LayoutTransformControl.LayoutTransform>
                        <Image Name="TextPreviewImage" Source="{Binding TextPreview}" Stretch="None"
                               RenderOptions.BitmapInterpolationMode="None" />
                    </LayoutTransformControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Grid.ColumnSpan="5" Classes="statusbar">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CharStatus}" />
                <TextBlock Text="{Binding Summary}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
