<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MULExplorer.ViewModels.Tabs"
             xmlns:r="using:MULExplorer.Resources"
             x:Class="MULExplorer.Views.Tabs.GumpsView"
             x:DataType="vm:GumpsViewModel">
    <Grid ColumnDefinitions="400,6,*" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Toolbars (UOFiddler: Index box on top, name/tag filter below) -->
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="6,6,6,0">
            <TextBlock VerticalAlignment="Center" Text="{x:Static r:GumpsStrings.GoToId}" />
            <TextBox Name="GoToBox" Width="140" PlaceholderText="{x:Static r:GumpsStrings.GoToWatermark}"
                     Text="{Binding GoToText}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="{x:Static r:GumpsStrings.PreviewHue}" />
            <NumericUpDown Name="HueBox" Width="130" Minimum="0" Maximum="3000" Increment="1" FormatString="0"
                           Value="{Binding PreviewHue}" />
            <CheckBox Name="OnlyGrayBox" Content="{x:Static r:GumpsStrings.OnlyGray}" IsChecked="{Binding OnlyGray}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="6">
            <TextBlock VerticalAlignment="Center" Text="{x:Static r:GumpsStrings.NameFilter}" />
            <TextBox Name="SearchBox" Width="220" PlaceholderText="{x:Static r:GumpsStrings.NameWatermark}"
                     Text="{Binding SearchText}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="{x:Static r:GumpsStrings.Tag}" />
            <ComboBox Name="TagBox" Width="170" ItemsSource="{Binding TagOptions}" SelectedItem="{Binding SelectedTag}" />
        </StackPanel>

        <!-- Gump list -->
        <ListBox Name="GumpList" Grid.Row="2" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:GumpRow">
                    <Grid ColumnDefinitions="104,*" Height="60">
                        <Image Source="{Binding Thumbnail}" MaxWidth="100" MaxHeight="56" Stretch="Uniform"
                               StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding IdText}" />
                            <TextBlock Text="{Binding Name}" IsVisible="{Binding HasName}" />
                            <TextBlock Classes="label" FontSize="11" Text="{Binding TagsText}"
                                       IsVisible="{Binding TagsText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="2" Grid.Column="1" ResizeDirection="Columns" />

        <!-- Preview + details -->
        <Grid Grid.Row="2" Grid.Column="2" RowDefinitions="*,Auto" Margin="8,0,8,0">
            <Border Classes="preview">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image Name="PreviewImage" Source="{Binding Preview}" Stretch="None"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ScrollViewer>
            </Border>
            <ItemsControl Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PropertyRow">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="label" Text="{Binding Label}" />
                            <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="3" Grid.ColumnSpan="3" Classes="statusbar">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectionText}" />
                <TextBlock Text="{Binding Summary}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
