<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MULExplorer.ViewModels.Tabs"
             xmlns:r="using:MULExplorer.Resources"
             x:Class="MULExplorer.Views.Tabs.HuesView"
             x:DataType="vm:HuesViewModel">
    <Grid ColumnDefinitions="*,6,420" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Toolbar (UOFiddler: index / name search and "Show ingame numbers") -->
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="6">
            <TextBox Name="SearchBox" Width="260" PlaceholderText="{x:Static r:HuesStrings.SearchWatermark}"
                     Text="{Binding SearchText}" />
            <CheckBox Name="GameNumbersBox" Content="{x:Static r:HuesStrings.ShowGameNumbers}" IsChecked="{Binding ShowGameNumbers}" />
        </StackPanel>

        <!-- Column header -->
        <Grid Grid.Row="1" ColumnDefinitions="120,170,*" Margin="6,0,18,2">
            <TextBlock Classes="label" Text="{x:Static r:HuesStrings.ColumnHue}" />
            <TextBlock Grid.Column="1" Classes="label" Text="{x:Static r:HuesStrings.ColumnName}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{x:Static r:HuesStrings.ColumnRamp}" />
        </Grid>

        <!-- Hue ramps -->
        <ListBox Name="HueList" Grid.Row="2" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="6,1" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:HueRow">
                    <Grid ColumnDefinitions="120,170,*" Height="20">
                        <TextBlock VerticalAlignment="Center" Text="{Binding NumberText}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <Image Grid.Column="2" Source="{Binding Ramp}" Stretch="Fill" Margin="0,1"
                               RenderOptions.BitmapInterpolationMode="None" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" ResizeDirection="Columns" />

        <!-- Selected hue -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="2">
            <StackPanel Margin="8" Spacing="8">
                <Border Classes="preview" Padding="0" Height="28">
                    <Image Source="{Binding SelectedRamp}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <ItemsControl ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PropertyRow">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Classes="label" Text="{Binding Label}" />
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Item / gump drawn with the hue -->
                <Grid ColumnDefinitions="Auto,8,*" RowDefinitions="Auto,Auto,Auto" >
                    <TextBlock VerticalAlignment="Center" Text="{x:Static r:HuesStrings.PreviewItem}" />
                    <NumericUpDown Name="ItemBox" Grid.Column="2" Minimum="0" Maximum="65535" Increment="1"
                                   FormatString="0" Value="{Binding PreviewItemId}" />
                    <TextBlock Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center" Text="{x:Static r:HuesStrings.PreviewGump}" />
                    <NumericUpDown Name="GumpBox" Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" Minimum="0" Maximum="65535"
                                   Increment="1" FormatString="0" Value="{Binding PreviewGumpId}" />
                    <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="{x:Static r:HuesStrings.OnlyGray}" IsChecked="{Binding OnlyGray}" />
                </Grid>
                <Grid ColumnDefinitions="*,8,*">
                    <Border Classes="preview" MinHeight="140">
                        <Image Name="ItemPreviewImage" Source="{Binding ItemPreview}" Stretch="Uniform" StretchDirection="DownOnly"
                               HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{x:Static r:HuesStrings.ItemPreview}" />
                    </Border>
                    <Border Grid.Column="2" Classes="preview" MinHeight="140">
                        <Image Name="GumpPreviewImage" Source="{Binding GumpPreview}" Stretch="Uniform" StretchDirection="DownOnly"
                               MaxHeight="260" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{x:Static r:HuesStrings.GumpPreview}" />
                    </Border>
                </Grid>

                <!-- The 32 colors -->
                <TextBlock Classes="label" Text="{x:Static r:HuesStrings.Colors}" />
                <ItemsControl ItemsSource="{Binding Colors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:HueColorRow">
                            <Grid ColumnDefinitions="28,40,70,*" Height="18">
                                <TextBlock Classes="label" VerticalAlignment="Center" Text="{Binding Index}" />
                                <Border Grid.Column="1" Margin="0,1,8,1" Background="{Binding Brush}" CornerRadius="2"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" />
                                <SelectableTextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Color16}" />
                                <SelectableTextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Rgb}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Classes="status" Text="{Binding Summary}" />
    </Grid>
</UserControl>
