<?xml version="1.0" encoding="utf-8"?>
<!--
  Native AOT: one native executable with no .NET runtime dependency. Avalonia's native
  renderer libraries (SkiaSharp, HarfBuzzSharp, ANGLE on Windows) ship next to it.

    dotnet publish MULExplorer -c Release -r win-x64 -p:PublishProfile=NativeAot
    dotnet publish MULExplorer -c Release -r linux-x64 -p:PublishProfile=NativeAot

  Must run on the target OS. Windows needs the VS C++ workload (and vswhere on PATH with
  Visual Studio 18); Linux needs clang and zlib1g-dev.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <PublishDir>$(MSBuildProjectDirectory)/../artifacts/publish/aot/$(RuntimeIdentifier)/</PublishDir>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Native packages (SkiaSharp, HarfBuzzSharp) ship large .pdb files; keep them out of the release. -->
  <Target Name="MULExplorerRemovePublishSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
