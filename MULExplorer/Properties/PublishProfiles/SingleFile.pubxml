<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single-file executable (JIT runtime bundled), for machines without the
  NativeAOT toolchain. Native libraries are embedded and extracted on first run.

    dotnet publish MULExplorer -c Release -r win-x64 -p:PublishProfile=SingleFile
    dotnet publish MULExplorer -c Release -r linux-x64 -p:PublishProfile=SingleFile

  Cross-publishing to another OS works with this profile.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)/../artifacts/publish/singlefile/$(RuntimeIdentifier)/</PublishDir>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Native packages (SkiaSharp, HarfBuzzSharp) ship large .pdb files; keep them out of the release. -->
  <Target Name="MULExplorerRemovePublishSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
